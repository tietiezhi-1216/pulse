{
  "name": "pulse-api-client",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "workspaces": [
    "packages/bruno-app",
    "packages/bruno-electron",
    "packages/bruno-cli",
    "packages/bruno-common",
    "packages/bruno-converters",
    "packages/bruno-schema",
    "packages/bruno-schema-types",
    "packages/bruno-query",
    "packages/bruno-js",
    "packages/bruno-lang",
    "packages/bruno-tests",
    "packages/bruno-toml",
    "packages/bruno-graphql-docs",
    "packages/bruno-requests",
    "packages/bruno-filestore"
  ],
  "homepage": "https://github.com/tietiezhi-1216/pulse",
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "@faker-js/faker": "^7.6.0",
    "@jest/globals": "^29.2.0",
    "@opencollection/types": "0.9.1",
    "@playwright/test": "^1.51.1",
    "@rollup/plugin-json": "^6.1.0",
    "@storybook/addon-webpack5-compiler-babel": "^4.0.0",
    "@storybook/builder-webpack5": "^10.1.10",
    "@storybook/react": "^10.1.10",
    "@storybook/react-webpack5": "^10.1.10",
    "@stylistic/eslint-plugin": "^5.3.1",
    "@types/jest": "^29.5.11",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.14.1",
    "@typescript-eslint/parser": "^8.39.0",
    "concurrently": "^8.2.2",
    "cross-env": "10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-diff": "^2.0.3",
    "fs-extra": "^11.1.1",
    "globals": "^16.1.0",
    "husky": "^9.1.7",
    "jest": "^29.2.0",
    "lodash-es": "^4.17.21",
    "nano-staged": "^0.8.0",
    "playwright": "^1.51.1",
    "pretty-quick": "^3.1.3",
    "randomstring": "^1.2.2",
    "rimraf": "^6.0.1",
    "storybook": "^10.1.10",
    "ts-jest": "^29.2.6",
    "ws": "^8.18.3"
  },
  "scripts": {
    "setup": "node ./scripts/setup.js",
    "watch:converters": "pnpm --filter @usebruno/converters watch",
    "dev": "node ./scripts/dev.js",
    "watch": "pnpm dev:watch",
    "dev:watch": "node ./scripts/dev-hot-reload.js",
    "dev:web": "pnpm --filter @usebruno/app dev",
    "build:workspace-libs": "pnpm build:schema-types && pnpm build:bruno-common && pnpm build:bruno-requests && pnpm build:bruno-filestore && pnpm build:bruno-converters && pnpm build:graphql-docs",
    "build:web": "pnpm build:workspace-libs && pnpm --filter @usebruno/app build",
    "dev:electron": "pnpm --filter pulse dev",
    "dev:electron:debug": "pnpm --filter pulse debug",
    "generate:icons": "node ./scripts/generate-pulse-icons.mjs",
    "storybook": "pnpm --filter @usebruno/app storybook",
    "build:bruno-common": "pnpm --filter @usebruno/common build",
    "build:bruno-requests": "pnpm --filter @usebruno/requests build",
    "build:bruno-filestore": "pnpm --filter @usebruno/filestore build",
    "build:bruno-converters": "pnpm --filter @usebruno/converters build",
    "build:bruno-query": "pnpm --filter @usebruno/query build",
    "build:graphql-docs": "pnpm --filter @usebruno/graphql-docs build",
    "build:schema-types": "pnpm --filter @usebruno/schema-types build",
    "build:electron": "node ./scripts/build-electron.js",
    "check:electron-asar": "node ./scripts/check-electron-asar-runtime-deps.mjs",
    "build:electron:mac": "./scripts/build-electron.sh mac",
    "build:electron:win": "./scripts/build-electron.sh win",
    "build:electron:linux": "./scripts/build-electron.sh linux",
    "build:electron:deb": "./scripts/build-electron.sh deb",
    "build:electron:rpm": "./scripts/build-electron.sh rpm",
    "build:electron:snap": "./scripts/build-electron.sh snap",
    "watch:common": "pnpm --filter @usebruno/common watch",
    "watch:requests": "pnpm --filter @usebruno/requests watch",
    "test:codegen": "node playwright/codegen.ts",
    "test:e2e": "playwright test --project=default",
    "test:e2e:ssl": "playwright test --project=ssl",
    "test:e2e:auth": "playwright test --project=auth",
    "test:benchmark": "playwright test --config=playwright.benchmark.config.ts",
    "lint": "cross-env NODE_OPTIONS=\"--max_old_space_size=4096\" pnpm exec eslint",
    "lint:fix": "cross-env NODE_OPTIONS=\"--max_old_space_size=4096\" pnpm exec eslint --fix",
    "prepare": "husky"
  },
  "nano-staged": {
    "*.{js,ts,jsx}": [
      "pnpm lint:fix"
    ]
  },
  "overrides": {
    "axios":"1.13.6",
    "rollup": "3.30.0",
    "pbkdf2":"3.1.5",
    "electron-store": {
      "conf": {
        "json-schema-typed": "8.0.1"
      }
    }
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "git-url-parse": "^14.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@scarf/scarf",
      "@tree-sitter-grammars/tree-sitter-yaml",
      "canvas",
      "core-js",
      "core-js-pure",
      "electron",
      "esbuild",
      "macos-export-certificate-and-key",
      "native-reg",
      "protobufjs",
      "tree-sitter",
      "tree-sitter-json"
    ]
  }
}
